// The app no longer uses Firestore. These rules close the old database.
// Publish them in the Firebase console (Firestore Database -> Rules) or with
// `firebase deploy --only firestore:rules`, then delete the old data if it is no longer needed.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
