# APP_URL: Public URL of the deployment. Used for the "Open Staff Dashboard" link in staff emails.
APP_URL="https://huesstayluxuryrooms.vercel.app"

# RESEND NOTIFICATION CONFIGURATION
# To trigger the Resend email, you must provide your Resend API Key.
RESEND_API_KEY="re_123456789"

# Single email recipient that should receive the hotel requests (Free Resend plan)
# Example: "huesstay@gmail.com"
RESEND_TO_EMAILS="huesstay@gmail.com"

# Sender address. Leave unset (or use a public webmail address) to send from onboarding@resend.dev.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SUPABASE CONFIGURATION
# Connects to your Supabase project (e.g. hues-stay-luxury-rooms)
# Find these in your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_ANON_KEY="eyJhbGciOi..."
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# SUPERHOST PIN (checked on the server; staff must also be signed in)
SUPERHOST_PIN="change-me"

# SIGNED QR LINKS
# Secret used to sign room links (/room/101.<signature>). At least 16 random characters.
# Changing it invalidates every printed QR code.
ROOM_LINK_SECRET="replace-with-a-long-random-string"
# Keep old printed QR codes (/room/101) working until the new signed cards are in every room.
# Set to "false" (or remove) once they are, so room pages cannot be opened by guessing numbers.
ALLOW_ROOM_NUMBER_LINKS="true"

# LOCAL DEV ONLY: lets `npm run dev` email staff about recent requests it finds in the
# database. Leave off: with live keys it would duplicate the real site's emails.
ENABLE_DEV_EMAIL_DAEMON="false"
